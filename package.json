{
  "name": "ticketcare",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "pm2:start:dev": "export NODE_ENV=development && npm i && npm run build && pm2 start --name ticketcare dist/main.js",
    "pm2:restart:dev": "export NODE_ENV=development && npm i && npm run build && pm2 restart --name ticketcare dist/main.js --update-env",
    "pm2:start:prod": "export NODE_ENV=production && npm i && npm run build && pm2 start --name ticketcare dist/main.js",
    "pm2:restart:prod": "export NODE_ENV=production && npm i && npm run build && pm2 restart --name ticketcare dist/main.js --update-env",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mongoose": "11.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "6.4.0",
    "axios": "^1.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "1.8.1",
    "dayjs": "^1.11.18",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "imapflow": "^1.7.2",
    "joi": "18.2.6",
    "mailparser": "^3.9.34",
    "mongoose": "8.24.4",
    "mongoose-paginate-v2": "1.9.1",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.6",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "24.7.2",
    "@types/nodemailer": "7.0.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
