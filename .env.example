# This file is a template for the .env file that will be used in the project.
# The .env file is used to store environment variables that will be used in the project.

# ----------------------------------------
# NODE ENVIRONMENT
# ----------------------------------------

# The port that the server will run on
PORT=3000
# The environment that the server is running in (local, development, production)
NODE_ENV=development

# ----------------------------------------
# MONGODB CONFIGURATION
# ----------------------------------------

# The MongoDB connection string
DB_URL=mongodb://localhost:27017/mydatabase


# ----------------------------------------
# JWT CONFIGURATION
# ----------------------------------------

# The secret key used to sign JWT tokens
JWT_SECRET=mysecretkey
# The expiration time for JWT tokens
JWT_EXPIRATION=1h


# ----------------------------------------
# EMAIL NOTIFICATIONS CONFIGURATION
# ----------------------------------------

# The email address to send notifications from
USER_NOTIFICATIONS=myemail@example.com
# The password for the email account
PASSWORD_NOTIFICATIONS=mypassword

# ----------------------------------------
# SERVER URL
# ----------------------------------------
# The URL of the server
URL_SERVER=http://localhost:3000


# ----------------------------------------
# DEFAULT USER CONFIGURATION
# ----------------------------------------
# The default user's name
DEFAULT_USER_NAME=Admin
# The default user's last name
DEFAULT_USER_LAST_NAME=User
# The default user's email
DEFAULT_USER_EMAIL=admin@example.com
# The default user's phone number
DEFAULT_USER_PHONE=0000000000
# The default user's password
DEFAULT_USER_PASSWORD=Admin1234!


# ----------------------------------------
# IMAP CONFIGURATION
# ----------------------------------------
# The IMAP user for email fetching
IMAP_USER=your_imap_user
# The IMAP password for email fetching
IMAP_PASSWORD=your_imap_password


# ----------------------------------------
# META CONFIGURATION
# ----------------------------------------
# The Meta API version
META_API_VERSION=v22.0
# The Meta phone number ID
META_PHONE_NUMBER_ID=your_phone_number_id
# The Meta access token
META_ACCESS_TOKEN=your_access_token
# The Meta base URL
META_BASE_URL=https://graph.facebook.com
# The webhook verify token
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token



